# Socket.io server URL (optional - app works in offline mode without it)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# PostgreSQL. Salin file ini ke .env.local lalu sesuaikan user, password, dan port.
# Terapkan skema dengan: npm run db:setup
# Port 5433 dipakai bila 5432 sudah diisi instalasi PostgreSQL lain.
DATABASE_URL=postgresql://USER@127.0.0.1:5433/halfpos
